# Database
# For local development (using Prisma dev):
# DATABASE_URL="prisma+postgres://..."

# For Supabase:
# DATABASE_URL="postgresql://postgres:[password]@[host]:[port]/postgres?schema=public&sslmode=require"

# For local Docker PostgreSQL:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/rustam"

DATABASE_URL="postgresql://user:password@localhost:5432/rustam_db?schema=public"

# Email Service (Resend)
# Get API key from https://resend.com
RESEND_API_KEY=""
EMAIL_FROM="noreply@rustambattery.com"

# Alternative: SMTP (Nodemailer)
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""

# Security - Cloudflare Turnstile
# Get keys from https://dash.cloudflare.com/turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Analytics
# Get ID from https://analytics.google.com
NEXT_PUBLIC_GA_ID=""

# App Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Optional: Sanity CMS
# NEXT_PUBLIC_SANITY_PROJECT_ID=""
# NEXT_PUBLIC_SANITY_DATASET="production"
# SANITY_API_TOKEN=""
