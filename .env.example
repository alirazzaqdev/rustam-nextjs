# ───────────────────────────────────────────────
# Database (Neon PostgreSQL)
# ───────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@ep-xxx.neon.tech/rustam?sslmode=require"

# ───────────────────────────────────────────────
# App
# ───────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL="https://your-domain.vercel.app"
NEXTAUTH_SECRET="your-random-secret-here"

# ───────────────────────────────────────────────
# Admin Credentials (no database auth)
# ───────────────────────────────────────────────
ADMIN_EMAIL="admin@rustambattery.com"
ADMIN_PASSWORD="your-secure-admin-password"

# ───────────────────────────────────────────────
# Email (Resend.dev)
# Get API key from https://resend.com
# ───────────────────────────────────────────────
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="noreply@rustambattery.com"

# ───────────────────────────────────────────────
# JazzCash (REST API v2)
# Get credentials from JazzCash merchant portal
# ───────────────────────────────────────────────
JAZZCASH_MERCHANT_ID="your-merchant-id"
JAZZCASH_PASSWORD="your-jazzcash-password"
JAZZCASH_INTEGRITY_SALT="your-integrity-salt"
# "sandbox" for testing, "production" for live
JAZZCASH_ENV="sandbox"

# ───────────────────────────────────────────────
# EasyPaisa (MA – Mobile Account API)
# Get credentials from EasyPaisa merchant portal
# ───────────────────────────────────────────────
EASYPAISA_STORE_ID="your-store-id"
EASYPAISA_HASH_KEY="your-hash-key"
# "sandbox" for testing, "production" for live
EASYPAISA_ENV="sandbox"
